{
    "name": "thingstelemetry/laravel-traccar",
    "description": "PHP and Laravel client for the Traccar API",
    "type": "library",
    "license": "MIT",
    "keywords": [ "traccar", "gps", "tracking", "laravel", "php", "api", "iot"],
    "authors": [
        {
            "name": "Njogu Amos",
            "email": "njoguamos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0 || ^13.0",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^3.8.4 || ^4.0.0",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "ThingsTelemetry\\Traccar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThingsTelemetry\\Traccar\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "format": "./vendor/bin/pint --parallel",
        "test": "./vendor/bin/pest",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ThingsTelemetry\\Traccar\\TraccarServiceProvider"
            ],
            "aliases": {
                "Server": "ThingsTelemetry\\Traccar\\Facades\\Server",
                "Device": "ThingsTelemetry\\Traccar\\Facades\\Device",
                "Event": "ThingsTelemetry\\Traccar\\Facades\\Event",
                "User": "ThingsTelemetry\\Traccar\\Facades\\User",
                "Position": "ThingsTelemetry\\Traccar\\Facades\\Position"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
  "archive": {
    "exclude": [
      "/tests",
      "/.github",
      "/docker-compose.yml",
      "/.gitignore",
      "workbench",
      "/testbench.yaml"
    ]
  }
}