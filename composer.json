{
    "name": "tracktelemetry/traccar-api",
    "description": "PHP and Laravel client for the Traccar API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "traccar",
        "gps",
        "tracking",
        "laravel",
        "php",
        "api"
    ],
    "authors": [
        {
            "name": "Njogu Amos",
            "email": "njoguamos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.32.5",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^3.8.4",
        "orchestra/testbench": "^10"
    },
    "autoload": {
        "psr-4": {
            "TrackTelemetry\\Traccar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrackTelemetry\\Traccar\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "format": "./vendor/bin/pint --parallel",
        "test": "./vendor/bin/pest",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "TrackTelemetry\\Traccar\\TraccarServiceProvider"
            ],
            "aliases": {
                "Server": "TrackTelemetry\\Traccar\\Facades\\Server"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}