{
  "name": "tracktelemetry/traccar-api",
  "description": "PHP and Laravel client for the Traccar API",
  "type": "library",
  "license": "MIT",
  "keywords": ["traccar", "gps", "tracking", "laravel", "php", "api"],
  "authors": [
    {
      "name": "Njogu Amos",
      "email": "njoguamos@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.32.5",
    "saloonphp/saloon": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.25.1",
    "pestphp/pest": "^4.1.2"
  },
  "autoload": {
    "psr-4": {
      "TrackTelemetry\\Traccar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TrackTelemetry\\Traccar\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": "./vendor/bin/pint --parallel",
    "test": "./vendor/bin/pest"
  },
  "extra": {
    "laravel": {
      "providers": [
        "TrackTelemetry\\Traccar\\TraccarServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
